# ==============================================================================
# O2CITY Environment Variables Template
# Copy to .env.local for local development. Never commit real .env files.
# Configure production secrets in Vercel Dashboard -> Project -> Environment Variables.
# ==============================================================================

# --- Server-Side Secrets (NEVER prefix with VITE_) ---
CPCB_API_KEY=
CPCB_API_BASE_URL=https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Firebase Admin SDK (server-side ingestion & API routes only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional cron/ingestion protection token for /api/ingest-aqi
INGEST_CRON_SECRET=

# Future Phase 2 (DO NOT use VITE_GEMINI_API_KEY)
GEMINI_API_KEY=

# --- Client-Safe Public Configuration ---
# Firebase Web SDK public config (safe for browser; protected by Firestore Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Mappls Maps Browser SDK Key (restrict by domain & required APIs in Mappls Console)
VITE_MAPPLS_MAP_KEY=
